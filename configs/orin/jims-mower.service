# Same unit as deploy/jims-mower.service — kept next to bench YAML.
# Copy to /etc/systemd/system/jims-mower.service. ESTOP is still hardware.

[Unit]
Description=Jim's Mower on-box control loop (no gym renderer)
Documentation=file:///opt/jims-mower/docs/ONBOX.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jims
Group=jims
WorkingDirectory=/var/lib/jims-mower
ExecStart=/usr/bin/jims-mower-onbox --config /etc/jims-mower/bench.yaml --blackbox /var/lib/jims-mower/blackbox.jsonl --hold --action 0,0,0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
