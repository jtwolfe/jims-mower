{
  "schema": "jims_mower.yard.v1",
  "name": "example_yard",
  "description": "Default suburban-scale keep-in for the owner app.",
  "width_m": 16.0,
  "height_m": 12.0,
  "resolution_m": 0.2,
  "home": {
    "x": 2.0,
    "y": 2.0,
    "theta": 0.0
  },
  "keep_in": [
    [1.0, 1.0],
    [15.0, 1.0],
    [15.0, 11.0],
    [1.0, 11.0]
  ],
  "keep_out": [
    [
      [7.0, 5.0],
      [9.0, 5.0],
      [9.0, 7.0],
      [7.0, 7.0]
    ]
  ],
  "mesh": "yard.glb",
  "radio": {
    "bluetooth": true,
    "wifi": {
      "enabled": false,
      "ssid": ""
    },
    "lora": {
      "enabled": true,
      "channel": 1
    },
    "primary": "lora"
  },
  "schedule": {
    "enabled": false,
    "days": ["mon", "wed", "fri"],
    "start_local": "09:00",
    "duration_min": 60,
    "timezone": "local",
    "min_soc": 0.25,
    "skip_rain": true,
    "arm_window_min": 15,
    "note": "weekly window — engine arms start when due"
  }
}
